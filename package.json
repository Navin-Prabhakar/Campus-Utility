{
  "name": "campus-utility",
  "version": "0.1.1",
  "private": true,
  "npm": {
    "config": {
      "legacy-peer-deps": true
    }
  },
  "overrides": {
    "next-auth": {
      "next": "$next",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "bash vercel-build.sh",
    "start": "next start",
    "lint": "next lint",
    "start:backend": "tsx ./src/backend/index.ts",
    "render-build": "npm install"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
